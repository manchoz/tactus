# Tactus UNO Q 5 GHz AP kernel config fragment (mainline Kconfig, zero C patches)
# Merged on top of arduino/arduino-deb-images kernel-configs/*.config.
# Distinct LOCALVERSION installs side-by-side with stock 7.2.11-arduino1+ in
# systemd-boot so rollback via bootctl/UART stays intact.
CONFIG_LOCALVERSION="-arduino1-tactus"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS=y
