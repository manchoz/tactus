[Unit]
Description=Tactus Linux LED1 Fault Indicator (fast-blink red)
DefaultDependencies=no

[Service]
Type=oneshot
RuntimeDirectory=tactus
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/bin/sh -c 'touch /run/tactus/fault; [ -d /sys/class/leds/unoq:user-red1 ] || exit 0; echo none > /sys/class/leds/unoq:user-green1/trigger; echo 0 > /sys/class/leds/unoq:user-green1/brightness; echo none > /sys/class/leds/unoq:user-blue1/trigger; echo 0 > /sys/class/leds/unoq:user-blue1/brightness; echo timer > /sys/class/leds/unoq:user-red1/trigger; echo 150 > /sys/class/leds/unoq:user-red1/delay_on; echo 150 > /sys/class/leds/unoq:user-red1/delay_off'
