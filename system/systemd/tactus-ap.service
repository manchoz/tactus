[Unit]
Description=Tactus WiFi Access Point (hostapd)
BindsTo=sys-subsystem-net-devices-wlan0.device
After=NetworkManager.service systemd-rfkill.service sys-subsystem-net-devices-wlan0.device
Wants=avahi-daemon.service
Upholds=tactus-dhcp.service
Before=tactus-dhcp.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
RuntimeDirectory=tactus
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=-/usr/sbin/rfkill unblock wifi
ExecStartPre=/usr/sbin/iw reg set IT
ExecStartPre=/usr/sbin/ip link set wlan0 up
ExecStartPre=/usr/sbin/ip addr replace 10.42.0.1/24 dev wlan0
ExecStart=/usr/sbin/hostapd /etc/hostapd/tactus-ap.conf
ExecStartPost=/bin/sh -c 'ready=0; i=0; while [ "$i" -lt 50 ]; do /usr/sbin/iw dev wlan0 info 2>/dev/null | grep -q "type AP" && { ready=1; break; }; i=$((i + 1)); sleep 0.1; done; [ "$ready" -eq 1 ] || exit 1; /usr/sbin/ip addr replace 10.42.0.1/24 dev wlan0; /usr/sbin/iw dev wlan0 set power_save off 2>/dev/null || true'
ExecStopPost=-/usr/sbin/ip addr del 10.42.0.1/24 dev wlan0
KillMode=control-group
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target sys-subsystem-net-devices-wlan0.device
