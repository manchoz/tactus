[Unit]
Description=Tactus WiFi Access Point (hostapd)
BindsTo=sys-subsystem-net-devices-wlan0.device
After=NetworkManager.service systemd-rfkill.service sys-subsystem-net-devices-wlan0.device
Wants=avahi-daemon.service
Upholds=tactus-dhcp.service
Before=tactus-dhcp.service
StartLimitIntervalSec=60s
StartLimitBurst=5
OnFailure=tactus-led-fault@%n.service

[Service]
Type=simple
RuntimeDirectory=tactus
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=-/usr/sbin/rfkill unblock wifi
ExecStartPre=/usr/sbin/iw reg set IT
ExecStartPre=/usr/sbin/ip link set wlan0 up
ExecStartPre=/usr/sbin/ip addr replace 10.42.0.1/24 dev wlan0
ExecStartPre=/bin/sh -c 'if /usr/sbin/iw list | /usr/bin/grep "5180.0 MHz" | /usr/bin/grep -q "no IR"; then src=/etc/hostapd/tactus-ap-2g.conf; else src=/etc/hostapd/tactus-ap.conf; fi; echo "tactus-ap: using $$src"; /usr/bin/install -m 0600 "$$src" /run/tactus/hostapd.conf'
ExecStart=/usr/sbin/hostapd /run/tactus/hostapd.conf
ExecStartPost=/bin/sh -c 'ready=0; i=0; while [ "$i" -lt 50 ]; do /usr/sbin/iw dev wlan0 info 2>/dev/null | grep -q "type AP" && { ready=1; break; }; i=$((i + 1)); sleep 0.1; done; [ "$ready" -eq 1 ] || exit 1; /usr/sbin/ip addr replace 10.42.0.1/24 dev wlan0 || exit 1; /usr/sbin/iw dev wlan0 set power_save off 2>/dev/null || true; /bin/touch /run/tactus/ap-ready; /bin/rm -f /run/tactus/fault.tactus-ap.service'
ExecStopPost=-/bin/rm -f /run/tactus/ap-ready
ExecStopPost=-/usr/sbin/ip addr del 10.42.0.1/24 dev wlan0
KillMode=control-group
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target sys-subsystem-net-devices-wlan0.device
