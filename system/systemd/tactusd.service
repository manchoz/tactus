[Unit]
Description=Tactus MIDI / Ableton Link Sync Daemon
After=network-online.target tactus-ap.service tactus-dhcp.service sound.target
Wants=tactus-ap.service

[Service]
Type=simple
User=tactus
SupplementaryGroups=audio
StateDirectory=tactus
StateDirectoryMode=0750
RuntimeDirectory=tactus
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/bin/tactusd --config /var/lib/tactus/config.toml
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK CAP_NET_BIND_SERVICE
LimitRTPRIO=95
LimitMEMLOCK=infinity
ProtectSystem=strict
ReadWritePaths=/var/lib/tactus /run/tactus -/run/arduino-router.sock
PrivateTmp=true
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
