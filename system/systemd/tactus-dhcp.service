[Unit]
Description=Tactus WiFi AP DHCP Server (DHCP-only dnsmasq)
BindsTo=tactus-ap.service
PartOf=tactus-ap.service
After=tactus-ap.service
OnFailure=tactus-led-fault.service

[Service]
Type=simple
RuntimeDirectory=tactus
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq.d/tactus-ap.conf
ExecStartPost=-/bin/rm -f /run/tactus/fault
ExecStopPost=-/bin/rm -f /run/tactus/dnsmasq.pid
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
